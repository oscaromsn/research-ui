{
  "name": "next-app",
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check . --log-level warn",
    "lint": "next lint",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --quiet",
    "lint:strict": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit --pretty",
    "typecheck:strict": "tsc --noEmit --strict --exactOptionalPropertyTypes --pretty",
    "knip": "knip --reporter codeowners",
    "knip:fix": "knip --fix --reporter codeowners",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --reporter=list",
    "test:e2e:ui": "playwright test --ui",
    "validate": "pnpm run typecheck && pnpm run lint:strict && pnpm run test && pnpm run format:check && pnpm run knip",
    "validate:quick": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "validate:full": "pnpm run validate && pnpm run test:coverage && pnpm run test:e2e",
    "ci": "pnpm run validate:full",
    "audit": "pnpm audit --audit-level moderate",
    "audit:fix": "pnpm update --latest",
    "bundle:analyze": "ANALYZE=true next build",
    "size": "size-limit --why",
    "deps:check": "dependency-cruiser src --output-type dot | dot -T svg > dependency-graph.svg",
    "clean": "rm -rf .next node_modules/.cache .turbo",
    "baml:generate": "baml-cli generate --verbose",
    "baml:test": "pnpm baml-cli test --dotenv-path .env.test --verbose",
    "docs:generate": "typedoc --out docs src",
    "help": "echo 'Common workflows:\n• Development: pnpm dev\n• Quality check: pnpm validate:quick\n• Full validation: pnpm validate:full\n• Fix formatting: pnpm format && pnpm lint:fix\n• Clean slate: pnpm clean && pnpm install'"
  },
  "dependencies": {
    "@boundaryml/baml": "0.88.0",
    "@boundaryml/baml-nextjs-plugin": "0.1.0",
    "@next/env": "15.4.0-canary",
    "@radix-ui/react-slot": "1.2.2",
    "@vitejs/plugin-react": "4.4.1",
    "axios": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "16.5.0",
    "jotai": "^2.12.4",
    "lucide-react": "0.511.0",
    "next": "15.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.3.0",
    "zod": "3.25.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/eslintrc": "3.3.1",
    "@next/bundle-analyzer": "^15.3.2",
    "@next/eslint-plugin-next": "15.3.2",
    "@playwright/test": "^1.52.0",
    "@size-limit/preset-app": "^11.1.6",
    "@tailwindcss/postcss": "4.1.7",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "22.15.19",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/strict-type-checked": "^8.32.1",
    "@vitest/coverage-v8": "3.1.4",
    "@vitest/ui": "3.1.4",
    "dependency-cruiser": "^16.8.0",
    "eslint": "9.27.0",
    "eslint-config-next": "15.3.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest-dom": "^5.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^2.0.4",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "eslint-plugin-testing-library": "^6.4.0",
    "happy-dom": "17.4.7",
    "husky": "^9.1.7",
    "knip": "^5.42.2",
    "lint-staged": "^15.2.11",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "size-limit": "^11.1.6",
    "tailwindcss": "4.1.7",
    "tw-animate-css": "1.3.0",
    "typedoc": "^0.26.14",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  },
  "size-limit": [
    {
      "name": "Client bundle",
      "path": ".next/static/chunks/*.js",
      "limit": "244 KB"
    }
  ],
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix --quiet", "prettier --write"],
    "*.{json,md,css}": ["prettier --write"]
  }
}
