{
  "compilerOptions": {
    // Environment setup
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "target": "ES2022",
    "module": "esnext",
    "types": [
      "node",
      "vitest/globals"
    ],
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    // Bundler mode
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Emit controls
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "removeComments": true,
    // Strict type checking
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    // Advanced strict checks
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "alwaysStrict": true,
    // Additional strictness
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false,
    // Experimental
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Next.js specific
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // Path mapping
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@components/*": [
        "components/*"
      ],
      "@ui/*": [
        "components/ui/*"
      ],
      "@domain/*": [
        "components/domain/*"
      ],
      "@layout/*": [
        "components/layout/*"
      ],
      "@lib/*": [
        "lib/*"
      ],
      "@state/*": [
        "lib/state/*"
      ],
      "@atoms/*": [
        "lib/state/atoms/*"
      ],
      "@utils/*": [
        "lib/utils/*"
      ],
      "@api/*": [
        "lib/api/*"
      ],
      "@types/*": [
        "types/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "plugins": [
    {
      "name": "next"
    }
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "vitest.config.ts",
    "**/*.mjs",
    "setupTests.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    ".next",
    "build",
    "coverage",
    "dist",
    "node_modules"
  ]
}
