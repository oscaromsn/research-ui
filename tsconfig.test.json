{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node", "@testing-library/jest-dom"],
    "composite": false
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "__tests__/**/*",
    "__mocks__/**/*",
    "setupTests.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", ".next", "dist", "build"]
}
