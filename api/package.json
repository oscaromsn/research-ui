{
  "name": "@jurisconsulta/api",
  "version": "0.1.0",
  "description": "JurisConsulta Elysia backend API server",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --minify",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bun tsc --noEmit",
    "baml:generate": "bunx baml-cli generate --from ./baml_src",
    "baml:test": "bunx baml-cli test --from ./baml_src",
    "baml:test:this": "bunx baml-cli test --from ./baml_src -i"
  },
  "dependencies": {
    "@boundaryml/baml": "^0.204.0",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/eden": "^1.3.2",
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.3.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
