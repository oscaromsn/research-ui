{
  "project": "./tsconfig.json",
  "atLeast": 99.0,
  "detail": true,
  "strict": true,
  "cache": false,
  "ignoreFiles": [
    "node_modules/**/*",
    ".next/**/*",
    "coverage/**/*",
    "dist/**/*",
    "build/**/*",
    "baml_client/**/*",
    "public/**/*",
    ".claude/**/*",
    ".zed/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "__tests__/**/*",
    "__mocks__/**/*",
    "setupTests.ts",
    "**/*.config.js",
    "**/*.config.mjs",
    "**/*.config.ts",
    "next-env.d.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "next.config.ts",
    "eslint.config.mjs",
    "postcss.config.mjs",
    "tailwind.config.js",
    "commitlint.config.ts"
  ],
  "ignoreCatch": false,
  "reportSemanticError": true,
  "enableCache": false,
  "showRelativePath": false
}
