{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "node_modules/**",
    ".next/**",
    "coverage/**",
    "dist/**",
    "build/**",
    "baml_client/**",
    "public/**",
    ".claude/**",
    ".zed/**",
    "__tests__/examples/**/*.example.ts",
    "types/test-globals.d.ts",
    "vitest.config.no-api.ts"
  ],
  "ignoreDependencies": [
    "@next/env",
    "postcss",
    "tailwindcss",
    "tw-animate-css",
    "zod"
  ],
  "rules": {
    "binaries": "warn",
    "dependencies": "error",
    "devDependencies": "warn",
    "duplicates": "error",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "nsExports": "warn",
    "classMembers": "warn",
    "types": "warn",
    "nsTypes": "warn",
    "unlisted": "warn",
    "unresolved": "error"
  },
  "includeEntryExports": false
}
