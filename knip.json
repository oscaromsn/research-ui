{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "binaries": "warn",
    "classMembers": "warn",
    "dependencies": "error",
    "devDependencies": "warn",
    "duplicates": "error",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "nsExports": "warn",
    "nsTypes": "warn",
    "types": "warn",
    "unlisted": "warn",
    "unresolved": "error"
  },
  "entry": [
    "*.config.{js,mjs,ts}",
    "__tests__/**",
    "app/actions/**/*.ts",
    "app/layout.tsx!",
    "app/page.tsx!",
    "e2e/**/*.ts!",
    "next.config.ts!",
    "setupTests.ts!"
  ],
  "project": [
    "**/*.{ts,tsx,js,jsx}"
  ],
  "ignore": [
    ".claude/**",
    ".next/**",
    "baml_client/**",
    "coverage/**",
    "node_modules/**",
    "public/**",
    "__tests/utils/**",
    "types/test-globals.d.ts",
    "vitest.config.no-api.ts"
  ],
  "ignoreDependencies": [
    "@next/env",
    "postcss",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreExportsUsedInFile": {
    "interface": false,
    "type": false
  },
  "includeEntryExports": true,
  "paths": {
    "@/*": [
      "./*"
    ],
    "@components/*": [
      "./components/*"
    ],
    "@ui/*": [
      "./components/ui/*"
    ],
    "@domain/*": [
      "./components/domain/*"
    ],
    "@layout/*": [
      "./components/layout/*"
    ],
    "@lib/*": [
      "./lib/*"
    ],
    "@state/*": [
      "./lib/state/*"
    ],
    "@utils/*": [
      "./lib/utils/*"
    ],
    "@api/*": [
      "./lib/api/*"
    ],
    "@types/*": [
      "./types/*"
    ]
  }
}
