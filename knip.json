{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "binaries": "warn",
    "classMembers": "warn",
    "dependencies": "error",
    "devDependencies": "warn",
    "duplicates": "error",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "nsExports": "warn",
    "nsTypes": "warn",
    "types": "warn",
    "unlisted": "warn",
    "unresolved": "error"
  },
  "entry": ["vitest.config.no-api.ts"],
  "project": [
    "app/**/*.{ts,tsx}!",
    "components/**/*.{ts,tsx}!",
    "lib/**/*.{ts,tsx}!",
    "baml_src/**/*.baml!",
    "__tests__/**/*.{ts,tsx}",
    "__mocks__/**/*.ts"
  ],
  "ignore": [],
  "ignoreDependencies": [
    "@next/env",
    "postcss",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreExportsUsedInFile": {
    "class": false,
    "enum": false,
    "function": false,
    "interface": false,
    "member": false,
    "type": false
  },
  "includeEntryExports": true
}
