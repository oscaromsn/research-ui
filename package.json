{
    "name": "next-app",
    "version": "0.1.0",
    "packageManager": "pnpm@10.11.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "eslint . --ext .ts,.tsx --quiet",
        "lint:fix": "eslint . --ext .ts,.tsx --fix --quiet",
        "lint:strict": "eslint . --ext .ts,.tsx --max-warnings 0",
        "typecheck": "tsc --noEmit --pretty",
        "typecheck:strict": "tsc --noEmit --strict --exactOptionalPropertyTypes --pretty",
        "knip": "knip --reporter codeowners",
        "knip:fix": "knip --fix --reporter codeowners",
        "typecov": "type-coverage --project tsconfig.json --detail --strict --at-least 90",
        "test": "vitest run --reporter=verbose",
        "test:watch": "vitest --reporter=verbose",
        "test:coverage": "vitest run --coverage --reporter=verbose",
        "test:ui": "vitest --ui",
        "test:e2e": "playwright test --reporter=list",
        "test:e2e:ui": "playwright test --ui",
        "validate": "pnpm run typecheck:strict && pnpm run lint:strict && pnpm run test && pnpm run format:check && pnpm run knip && pnpm run typecov",
        "validate:quick": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
        "validate:full": "pnpm run validate && pnpm run test:coverage && pnpm run test:e2e",
        "ci": "pnpm run validate:full",
        "baml:generate": "baml-cli generate --verbose",
        "baml:test": "pnpm baml-cli test --dotenv-path .env.test --verbose"
    },
    "dependencies": {
        "@boundaryml/baml": "0.89.0",
        "@boundaryml/baml-nextjs-plugin": "0.1.0",
        "@next/env": "15.4.0-canary.51",
        "@radix-ui/react-slot": "1.2.2",
        "@vitejs/plugin-react": "4.4.1",
        "axios": "1.9.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "dotenv": "16.5.0",
        "jotai": "^2.12.4",
        "lucide-react": "0.511.0",
        "next": "15.3.2",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "tailwind-merge": "3.3.0",
        "zod": "3.25.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@eslint/eslintrc": "3.3.1",
        "@next/eslint-plugin-next": "15.3.2",
        "@playwright/test": "^1.52.0",
        "@tailwindcss/postcss": "4.1.7",
        "@testing-library/jest-dom": "6.6.3",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "22.15.19",
        "@types/react": "19.1.4",
        "@types/react-dom": "19.1.5",
        "@typescript-eslint/eslint-plugin": "^8.32.1",
        "@typescript-eslint/parser": "^8.33.0",
        "@vitest/coverage-v8": "3.1.4",
        "@vitest/eslint-plugin": "^1.2.1",
        "@vitest/ui": "3.1.4",
        "eslint": "9.27.0",
        "eslint-config-next": "15.3.2",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest-dom": "^5.5.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-no-unsanitized": "^4.1.2",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "5.2.0",
        "eslint-plugin-regexp": "^2.7.0",
        "eslint-plugin-security": "^3.0.1",
        "eslint-plugin-sonarjs": "^3.0.2",
        "eslint-plugin-tailwindcss": "^3.18.0",
        "eslint-plugin-testing-library": "^7.2.2",
        "eslint-plugin-unicorn": "^59.0.1",
        "globals": "^16.2.0",
        "happy-dom": "17.4.7",
        "knip": "^5.59.0",
        "tailwindcss": "4.1.7",
        "tw-animate-css": "1.3.0",
        "type-coverage": "^2.29.7",
        "typescript": "5.8.3",
        "typescript-eslint": "^8.33.0",
        "vitest": "3.1.4"
    }
}
