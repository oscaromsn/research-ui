{
	"name": "lexisynth",
	"version": "0.1.0",
	"private": true,
	"// === QUICK REFERENCE ===": "For detailed testing docs see docs/TESTING.md",
	"// Development": "bun run test (fast unit tests) | bun run test:watch (watch mode)",
	"// Integration": "bun run test:integration (slow, needs API keys) | bun run test:all (everything)",
	"// CI/CD": "bun ci (full validation suite)",
	"scripts": {
		"// === DEVELOPMENT ===": "",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"clean": "rm -rf .next node_modules/.cache .turbo",
		"// === CODE QUALITY ===": "",
		"check": "biome check --write .",
		"lint:strict": "biome lint --write . --error-on-warnings",
		"typecheck": "tsc --noEmit --pretty",
		"typecheck:strict": "tsc --noEmit --strict --exactOptionalPropertyTypes --pretty",
		"knip": "knip",
		"knip:fix": "knip --fix",
		"typecov": "type-coverage --config type-coverage.json",
		"// === TESTING (Choose your test level) ===": "",
		"// TIP: fast(mocked) < medium(some APIs) < slow(full APIs) - choose based on your needs": "",
		"test": "vitest run --exclude='**/*integration*' --reporter=verbose",
		"test:watch": "vitest --exclude='**/*integration*' --reporter=verbose",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage --reporter=verbose",
		"test:file": "vitest run --reporter=verbose",
		"test:file:watch": "vitest --reporter=verbose",
		"// Unit Tests - Fast, no external dependencies": "",
		"test:unit": "vitest run --exclude='**/*integration*' --exclude='**/*e2e*' --reporter=verbose",
		"test:unit:watch": "vitest --exclude='**/*integration*' --exclude='**/*e2e*' --reporter=verbose",
		"// Integration Tests - Fast (mocked APIs, under 1s, good for development)": "",
		"test:integration:fast": "vitest run __tests__/integration/fast/ --reporter=verbose --testTimeout=30000",
		"test:integration:fast:watch": "vitest __tests__/integration/fast/ --reporter=verbose --testTimeout=30000",
		"// Integration Tests - Medium (some API calls, requires EXA_API_KEY, moderate duration)": "",
		"test:integration:medium": "vitest run __tests__/integration/medium/ --reporter=verbose --testTimeout=60000",
		"test:integration:medium:watch": "vitest __tests__/integration/medium/ --reporter=verbose --testTimeout=60000",
		"test:integration:medium:debug": "DEBUG_API_TESTS=true vitest run __tests__/integration/medium/ --reporter=verbose --testTimeout=60000",
		"// Integration Tests - Slow (comprehensive API calls, requires GOOGLE_API_KEY & EXA_API_KEY)": "",
		"test:integration:slow": "vitest run __tests__/integration/slow/ --reporter=verbose --testTimeout=300000",
		"test:integration:slow:watch": "vitest __tests__/integration/slow/ --reporter=verbose --testTimeout=300000",
		"test:integration:slow:debug": "DEBUG_API_TESTS=true vitest run __tests__/integration/slow/ --reporter=verbose --testTimeout=300000",
		"// All Integration Tests (fast + slow, use for comprehensive validation)": "",
		"test:integration": "vitest run __tests__/integration/ --reporter=verbose --testTimeout=300000",
		"test:integration:watch": "vitest __tests__/integration/ --reporter=verbose --testTimeout=300000",
		"test:integration:debug": "DEBUG_API_TESTS=true vitest run __tests__/integration/ --reporter=verbose --testTimeout=300000",
		"// BAML AI Tests - Requires AI API keys": "",
		"test:baml": "bun baml:test",
		"test:baml:safe": "bun baml:test:safe",
		"// E2E Tests - Browser automation": "",
		"test:e2e": "playwright test --reporter=list",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"// All Tests - Balanced (for development, includes some API validation)": "",
		"test:all": "bun run test:unit && bun run test:integration:medium && bun run test:e2e",
		"test:all:coverage": "bun run test:coverage && bun run test:integration:medium && bun run test:e2e",
		"// All Tests - Comprehensive (for CI/CD, includes slow API tests)": "",
		"test:all:full": "bun run test:unit && bun run test:integration && bun run test:e2e",
		"test:all:full:coverage": "bun run test:coverage && bun run test:integration && bun run test:e2e",
		"// === VALIDATION & CI/CD ===": "",
		"validate": "bun run format && bun run lint:strict && bun run typecheck:strict && bun run test:unit && bun run knip && bun run typecov && bun run deps:check",
		"validate:quick": "bun run format && bun run lint && bun run typecheck",
		"validate:full": "bun run validate && bun run test:all:full:coverage && bun run size",
		"ci": "bun run validate:full",
		"// === MAINTENANCE ===": "",
		"audit": "bun audit",
		"audit:fix": "bun update",
		"bundle:analyze": "ANALYZE=true next build",
		"size": "size-limit",
		"size:debug": "size-limit --debug",
		"size:analyze": "size-limit --json > bundle-analysis.json",
		"deps:check": "dependency-cruiser app components lib --output-type err-long",
		"deps:graph": "dependency-cruiser app components lib --output-type mermaid > dependency-graph.md && mv dependency-graph.md docs/features",
		"deps:report": "dependency-cruiser app components lib --output-type json > dependency-report.json && mv dependency-report.json docs/features",
		"// === AI/BAML TOOLS ===": "",
		"baml:generate": "baml-cli fmt && baml-cli generate",
		"baml:test": "baml-cli test --dotenv-path .env.test",
		"baml:test:safe": "baml-cli test --dotenv-path .env.test || echo 'BAML tests failed (likely due to missing API keys)'",
		"// === GIT WORKFLOW ===": "",
		"commit": "git add . && git-cz",
		"precommit": "lint-staged",
		"commitlint": "commitlint --edit",
		"prepare": "husky"
	},
	"dependencies": {
		"@boundaryml/baml": "0.89.0",
		"@boundaryml/baml-nextjs-plugin": "0.1.0",
		"@next/env": "15.4.0-canary.51",
		"@radix-ui/react-collapsible": "^1.1.11",
		"@radix-ui/react-slot": "1.2.2",
		"@radix-ui/react-switch": "^1.2.5",
		"@vitejs/plugin-react": "4.4.1",
		"axios": "1.9.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"dotenv": "16.5.0",
		"jotai": "^2.12.4",
		"lucide-react": "0.511.0",
		"next": "15.3.2",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"tailwind-merge": "3.3.0",
		"zod": "3.25.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@commitlint/types": "^19.8.1",
		"@playwright/test": "^1.52.0",
		"@size-limit/file": "^11.2.0",
		"@tailwindcss/postcss": "4.1.7",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "22.15.19",
		"@types/react": "19.1.4",
		"@types/react-dom": "19.1.5",
		"@vitest/coverage-v8": "3.1.4",
		"@vitest/ui": "3.1.4",
		"dependency-cruiser": "^16.10.2",
		"happy-dom": "17.4.7",
		"husky": "^9.1.7",
		"knip": "^5.59.0",
		"lint-staged": "^16.1.0",
		"size-limit": "^11.2.0",
		"tailwindcss": "4.1.7",
		"tw-animate-css": "1.3.0",
		"type-coverage": "^2.29.7",
		"typescript": "5.8.3",
		"vitest": "3.1.4"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@scarf/scarf",
		"@tailwindcss/oxide",
		"esbuild",
		"sharp",
		"unrs-resolver"
	]
}
