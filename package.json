{
  "name": "JurisConsulta",
  "version": "0.1.0",
  "private": true,
  "// === QUICK REFERENCE ===": "For detailed testing docs see docs/TESTING.md",
  "// Development": "bun run test (fast unit tests) | bun run test:watch (watch mode)",
  "// Integration": "bun run test:integration (slow, needs API keys) | bun run test:all (everything)",
  "// CI/CD": "bun ci (full validation suite)",
  "scripts": {
    "// === DEVELOPMENT ===": "",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next node_modules/.cache .turbo",
    "// === CODE QUALITY ===": "",
    "check": "biome check . --write .",
    "check:unsafe": "biome check . --write --unsafe",
    "lint": "biome lint . --write --no-errors-on-unmatched",
    "format": "biome format . --write --no-errors-on-unmatched",
    "typecheck": "tsc --noEmit --pretty",
    "typecheck:strict": "tsc --noEmit --strict --exactOptionalPropertyTypes --pretty",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "typecov": "type-coverage --config type-coverage.json",
    "// === TESTING (Choose your test level) ===": "",
    "// TIP: fast(mocked) < medium(some APIs) < slow(full APIs) - choose based on your needs": "",
    "// OUTPUT: Default = concise (dots), :verbose = detailed, :file = single file with verbose": "",
    "// USAGE: 'bun run test' (concise) | 'bun run test:verbose' (detailed) | 'bun test:file path' (single)": "",
    "test": "npx vitest run --exclude='**/*integration*'",
    "test:verbose": "VITEST_VERBOSE=true npx vitest run --exclude='**/*integration*'",
    "test:watch": "npx vitest --exclude='**/*integration*'",
    "test:watch:verbose": "VITEST_VERBOSE=true npx vitest --exclude='**/*integration*'",
    "test:ui": "npx vitest --ui",
    "test:bun": "bun test --exclude='**/*integration*'",
    "test:coverage": "vitest run --coverage",
    "test:coverage:verbose": "VITEST_VERBOSE=true vitest run --coverage",
    "test:file": "VITEST_VERBOSE=true vitest run",
    "test:file:watch": "VITEST_VERBOSE=true vitest",
    "// Unit Tests - Fast, no external dependencies": "",
    "test:unit": "vitest run --exclude='**/*integration*' --exclude='**/*e2e*'",
    "test:unit:verbose": "VITEST_VERBOSE=true vitest run --exclude='**/*integration*' --exclude='**/*e2e*'",
    "test:unit:watch": "vitest --exclude='**/*integration*' --exclude='**/*e2e*'",
    "test:unit:watch:verbose": "VITEST_VERBOSE=true vitest --exclude='**/*integration*' --exclude='**/*e2e*'",
    "// Integration Tests - Fast (mocked APIs, under 1s, good for development)": "",
    "test:integration:fast": "vitest run __tests__/integration/fast/ --testTimeout=30000",
    "test:integration:fast:verbose": "VITEST_VERBOSE=true vitest run __tests__/integration/fast/ --testTimeout=30000",
    "test:integration:fast:watch": "vitest __tests__/integration/fast/ --testTimeout=30000",
    "test:integration:fast:watch:verbose": "VITEST_VERBOSE=true vitest __tests__/integration/fast/ --testTimeout=30000",
    "// Integration Tests - Medium (some API calls, requires EXA_API_KEY, moderate duration)": "",
    "test:integration:medium": "vitest run __tests__/integration/medium/ --testTimeout=60000",
    "test:integration:medium:verbose": "VITEST_VERBOSE=true vitest run __tests__/integration/medium/ --testTimeout=60000",
    "test:integration:medium:watch": "vitest __tests__/integration/medium/ --testTimeout=60000",
    "test:integration:medium:watch:verbose": "VITEST_VERBOSE=true vitest __tests__/integration/medium/ --testTimeout=60000",
    "test:integration:medium:debug": "DEBUG_API_TESTS=true VITEST_VERBOSE=true vitest run __tests__/integration/medium/ --testTimeout=60000",
    "// Integration Tests - Slow (comprehensive API calls, requires GOOGLE_API_KEY & EXA_API_KEY)": "",
    "test:integration:slow": "vitest run __tests__/integration/slow/ --testTimeout=300000",
    "test:integration:slow:verbose": "VITEST_VERBOSE=true vitest run __tests__/integration/slow/ --testTimeout=300000",
    "test:integration:slow:watch": "vitest __tests__/integration/slow/ --testTimeout=300000",
    "test:integration:slow:watch:verbose": "VITEST_VERBOSE=true vitest __tests__/integration/slow/ --testTimeout=300000",
    "test:integration:slow:debug": "DEBUG_API_TESTS=true VITEST_VERBOSE=true vitest run __tests__/integration/slow/ --testTimeout=300000",
    "// All Integration Tests (fast + slow, use for comprehensive validation)": "",
    "test:integration": "vitest run __tests__/integration/ --testTimeout=300000",
    "test:integration:verbose": "VITEST_VERBOSE=true vitest run __tests__/integration/ --testTimeout=300000",
    "test:integration:watch": "vitest __tests__/integration/ --testTimeout=300000",
    "test:integration:watch:verbose": "VITEST_VERBOSE=true vitest __tests__/integration/ --testTimeout=300000",
    "test:integration:debug": "DEBUG_API_TESTS=true VITEST_VERBOSE=true vitest run __tests__/integration/ --testTimeout=300000",
    "// E2E Tests - Browser automation": "",
    "test:e2e": "playwright test --reporter=list",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "// All Tests - Balanced (for development, includes some API validation)": "",
    "test:all": "bun run test:unit && bun run test:integration:medium && bun run test:e2e",
    "test:all:verbose": "bun run test:unit:verbose && bun run test:integration:medium:verbose && bun run test:e2e",
    "test:all:coverage": "bun run test:coverage && bun run test:integration:medium && bun run test:e2e",
    "test:all:coverage:verbose": "bun run test:coverage:verbose && bun run test:integration:medium:verbose && bun run test:e2e",
    "// All Tests - Comprehensive (for CI/CD, includes slow API tests)": "",
    "test:all:full": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:all:full:verbose": "bun run test:unit:verbose && bun run test:integration:verbose && bun run test:e2e",
    "test:all:full:coverage": "bun run test:coverage && bun run test:integration && bun run test:e2e",
    "test:all:full:coverage:verbose": "bun run test:coverage:verbose && bun run test:integration:verbose && bun run test:e2e",
    "// === VALIDATION & CI/CD ===": "",
    "validate:quick": "bun check && bun typecheck && bun run test",
    "validate:essential": "bun format && bun typecheck:strict && bun test:unit --run --bail=1 --reporter=basic",
    "validate": "bun check && bun typecheck:strict && bun run test:unit && bun run knip && bun run typecov && bun run deps:check",
    "validate:full": "bun run validate && bun run test:all:full:coverage && bun run size",
    "validate:verbose": "bun check && bun typecheck:strict && bun run test:unit:verbose && bun run knip && bun run typecov && bun run deps:check",
    "ci": "bun run validate:full",
    "// === HOOK HELPERS ===": "",
    "hooks:fix": "bunx lint-staged --allow-empty",
    "hooks:test": "echo 'Testing hooks...' && bun run validate:essential",
    "// === MAINTENANCE ===": "",
    "audit": "bun audit",
    "audit:fix": "bun update",
    "bundle:analyze": "ANALYZE=true next build",
    "size": "size-limit",
    "size:debug": "size-limit --debug",
    "size:analyze": "size-limit --json > bundle-analysis.json",
    "deps:check": "dependency-cruiser app components lib --output-type err-long",
    "deps:graph": "dependency-cruiser app components lib --output-type mermaid > dependency-graph.md && mv dependency-graph.md docs/features",
    "deps:report": "dependency-cruiser app components lib --output-type json > dependency-report.json && mv dependency-report.json docs/features",
    "// === AI/BAML TOOLS ===": "",
    "baml:generate": "baml-cli fmt && baml-cli generate",
    "baml:test": "baml-cli test --dotenv-path .env.test",
    "baml:test:this": "baml-cli test --dotenv-path .env.test -i",
    "// === GIT WORKFLOW ===": "",
    "commit": "git add . && git-cz",
    "commit:fast": "SKIP_RELATED_TESTS=true git add . && git-cz",
    "push:fast": "FAST_PUSH=true git push",
    "push:skip": "SKIP_VALIDATION=true git push",
    "precommit": "lint-staged",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "@boundaryml/baml": "^0.202.1",
    "@boundaryml/baml-nextjs-plugin": "^0.1.0",
    "@next/env": "15.4.0-canary.51",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "1.2.2",
    "@radix-ui/react-switch": "^1.2.5",
    "@vitejs/plugin-react": "4.4.1",
    "axios": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "16.5.0",
    "jotai": "^2.12.5",
    "lucide-react": "0.511.0",
    "next": "15.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-textarea-autosize": "^8.5.9",
    "tailwind-merge": "3.3.0",
    "zod": "3.25.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@playwright/test": "^1.53.0",
    "@size-limit/file": "^11.2.0",
    "@tailwindcss/postcss": "4.1.7",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "latest",
    "@types/node": "22.15.19",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@types/react-textarea-autosize": "^8.0.0",
    "@vitest/coverage-v8": "3.1.4",
    "@vitest/ui": "3.1.4",
    "commitizen": "^4.3.1",
    "dependency-cruiser": "^16.10.3",
    "git-cz": "^4.9.0",
    "happy-dom": "17.4.7",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "knip": "^5.61.0",
    "lint-staged": "^16.1.2",
    "size-limit": "^11.2.0",
    "tailwindcss": "4.1.7",
    "tw-animate-css": "1.3.0",
    "type-coverage": "^2.29.7",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@scarf/scarf",
    "@tailwindcss/oxide",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
