{
  "name": "lexisynth",
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "private": true,
  "// === QUICK REFERENCE ===": "For detailed testing docs see docs/TESTING.md",
  "// Development": "pnpm test (fast unit tests) | pnpm test:watch (watch mode)",
  "// Integration": "pnpm test:integration (slow, needs API keys) | pnpm test:all (everything)",
  "// CI/CD": "pnpm ci (full validation suite)",
  "scripts": {
    "// === DEVELOPMENT ===": "",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next node_modules/.cache .turbo",
    "// === CODE QUALITY ===": "",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "eslint . --ext .ts,.tsx --quiet",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --quiet",
    "lint:strict": "eslint . --ext .ts,.tsx --max-warnings 0 --fix",
    "typecheck": "tsc --noEmit --pretty",
    "typecheck:strict": "tsc --noEmit --strict --exactOptionalPropertyTypes --pretty",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "typecov": "type-coverage --config type-coverage.json",
    "// === TESTING (Choose your test level) ===": "",
    "test": "vitest run --exclude='**/*integration*' --reporter=verbose",
    "test:watch": "vitest --exclude='**/*integration*' --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:file": "vitest run --reporter=verbose",
    "test:file:watch": "vitest --reporter=verbose",
    "// Unit Tests - Fast, no external dependencies": "",
    "test:unit": "vitest run --exclude='**/*integration*' --exclude='**/*e2e*' --reporter=verbose",
    "test:unit:watch": "vitest --exclude='**/*integration*' --exclude='**/*e2e*' --reporter=verbose",
    "// Integration Tests - Slow, requires API keys": "",
    "test:integration": "vitest run __tests__/integration/ --reporter=verbose --testTimeout=300000",
    "test:integration:watch": "vitest __tests__/integration/ --reporter=verbose --testTimeout=300000",
    "test:integration:debug": "DEBUG_API_TESTS=true vitest run __tests__/integration/ --reporter=verbose --testTimeout=300000",
    "// BAML AI Tests - Requires AI API keys": "",
    "test:baml": "pnpm baml:test",
    "test:baml:safe": "pnpm baml:test:safe",
    "// E2E Tests - Browser automation": "",
    "test:e2e": "playwright test --reporter=list",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "// All Tests (for CI/CD)": "",
    "test:all": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:all:coverage": "pnpm run test:coverage && pnpm run test:integration && pnpm run test:e2e",
    "// === VALIDATION & CI/CD ===": "",
    "validate": "pnpm run typecheck:strict && pnpm run lint:strict && pnpm run test:unit && pnpm run format:check && pnpm run knip && pnpm run typecov && pnpm run deps:check",
    "validate:quick": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "validate:full": "pnpm run validate && pnpm run test:all:coverage && pnpm run size",
    "ci": "pnpm run validate:full",
    "// === MAINTENANCE ===": "",
    "audit": "pnpm audit --audit-level moderate",
    "audit:fix": "pnpm update --latest",
    "bundle:analyze": "ANALYZE=true next build",
    "size": "size-limit",
    "size:debug": "size-limit --debug",
    "size:analyze": "size-limit --json > bundle-analysis.json",
    "deps:check": "dependency-cruiser app components lib --output-type err-long",
    "deps:graph": "dependency-cruiser app components lib --output-type mermaid > dependency-graph.md && mv dependency-graph.md docs/features",
    "deps:report": "dependency-cruiser app components lib --output-type json > dependency-report.json && mv dependency-report.json docs/features",
    "// === AI/BAML TOOLS ===": "",
    "baml:generate": "baml-cli fmt && baml-cli generate",
    "baml:test": "baml-cli test --dotenv-path .env.test",
    "baml:test:safe": "baml-cli test --dotenv-path .env.test || echo 'BAML tests failed (likely due to missing API keys)'",
    "// === GIT WORKFLOW ===": "",
    "commit": "git add . && git-cz",
    "precommit": "lint-staged",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "@boundaryml/baml": "0.89.0",
    "@boundaryml/baml-nextjs-plugin": "0.1.0",
    "@next/env": "15.4.0-canary.51",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-slot": "1.2.2",
    "@radix-ui/react-switch": "^1.2.5",
    "@vitejs/plugin-react": "4.4.1",
    "axios": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "16.5.0",
    "jotai": "^2.12.4",
    "lucide-react": "0.511.0",
    "next": "15.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.3.0",
    "zod": "3.25.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@eslint/eslintrc": "3.3.1",
    "@next/eslint-plugin-next": "15.3.2",
    "@playwright/test": "^1.52.0",
    "@size-limit/file": "^11.2.0",
    "@tailwindcss/postcss": "4.1.7",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.19",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitest/coverage-v8": "3.1.4",
    "@vitest/eslint-plugin": "^1.2.1",
    "@vitest/ui": "3.1.4",
    "dependency-cruiser": "^16.10.2",
    "eslint": "9.27.0",
    "eslint-config-next": "^15.3.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-testing-library": "^7.2.2",
    "globals": "^16.2.0",
    "happy-dom": "17.4.7",
    "husky": "^9.1.7",
    "knip": "^5.59.0",
    "lint-staged": "^16.1.0",
    "size-limit": "^11.2.0",
    "tailwindcss": "4.1.7",
    "tw-animate-css": "1.3.0",
    "type-coverage": "^2.29.7",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "3.1.4"
  }
}
